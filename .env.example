# ==============================================================================
# HỆ THỐNG HỖ TRỢ YÊU CẦU KHÁCH HÀNG - BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Sao chép file này thành .env trước khi chạy docker compose: cp .env.example .env
# ==============================================================================

# Cấu hình Cổng truy cập ngoài (Host Ports)
CLIENT_PORT=3000
SUPPORT_API_PORT=5000
NOTIFICATION_SERVICE_PORT=5001
RABBITMQ_NODE_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
POSTGRES_PORT=5432

# Cấu hình PostgreSQL
POSTGRES_DB=ticket_support_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_2026

# Chuỗi kết nối Database (Dùng trong Docker Network)
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=ticket_support_db;Username=postgres;Password=postgres_secure_password_2026

# Cấu hình RabbitMQ
RabbitMQ__HostName=rabbitmq
RabbitMQ__Port=5672
RabbitMQ__UserName=guest
RabbitMQ__Password=guest
RabbitMQ__ExchangeName=ticket.exchange

# Cấu hình CORS và Service URLs
Cors__AllowedOrigins=http://localhost:3000
NotificationService__HubUrl=http://notification-service:8080/hubs/notifications
